# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...

# Optional: restrict bot to these Telegram user ids (comma-separated)
# TELEGRAM_ALLOWED_USER_IDS=123456789

# Google Sheets — default spreadsheet (used until a user sets their own via /set_sheet)
GOOGLE_SPREADSHEET_ID=1M4X9kFTgdTYL68QnBRIUkSA2IhV3hz00opUqaOC8Rcw
GOOGLE_OAUTH_CLIENT_SECRETS=./secrets/client_secret.json
GOOGLE_OAUTH_TOKEN=./secrets/token.json

# Per-Telegram-user prefs (spreadsheet id JSON). Default: ./data/users.json
# DATA_DIR=./data

# Optional worksheet titles (defaults match the live spreadsheet)
# WS_CASUAL=Повседневные
# WS_FLAT=Квартира
# WS_BIG=Крупные
# WS_TRANSFERS=Переводы
# WS_DIRECTORY=Справочники
